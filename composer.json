{
    "name": "gauridevwork/content-decay-detector",
    "description": "Detects decaying WordPress content and suggests fixes.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.0",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "ContentDecayDetector\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContentDecayDetector\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}